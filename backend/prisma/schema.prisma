generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  client
  logistics

  @@map("user_role")
}

enum UserStatus {
  active
  blocked
  pending

  @@map("user_status")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String?         @unique @db.Citext
  phone           String?         @unique @db.VarChar(32)
  passwordHash    String          @map("password_hash")
  role            UserRole
  status          UserStatus      @default(active)
  isEmailVerified Boolean         @default(false) @map("is_email_verified")
  isPhoneVerified Boolean         @default(false) @map("is_phone_verified")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)

  profile         UserProfile?
  managerProfile  ManagerProfile?
  clientProfile   ClientProfile?
  sessions        UserSession[]
  devices         DeviceSession[]
  userRoles       UserRoleLink[]  @relation("user_role_user")
  assignedRoles   UserRoleLink[]  @relation("user_role_assigned_by")
  userPermissions UserPermission[] @relation("user_permission_user")
  grantedPerms    UserPermission[] @relation("user_permission_granted_by")

  @@map("users")
}

model UserProfile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  firstName String? @map("first_name") @db.VarChar(80)
  lastName  String? @map("last_name") @db.VarChar(80)
  avatarUrl String? @map("avatar_url")
  locale    String? @db.VarChar(16)
  timezone  String? @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ManagerProfile {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  employeeCode String? @map("employee_code") @db.VarChar(64)
  department   String? @db.VarChar(80)
  position     String? @db.VarChar(80)
  hiredAt      DateTime? @map("hired_at") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_profiles")
}

model ClientProfile {
  id                     String  @id @default(uuid()) @db.Uuid
  userId                 String  @unique @map("user_id") @db.Uuid
  companyName            String? @map("company_name") @db.VarChar(255)
  taxId                  String? @map("tax_id") @db.VarChar(64)
  notes                  String?
  preferredContactChannel String? @map("preferred_contact_channel") @db.VarChar(32)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  deviceId         String?  @map("device_id") @db.VarChar(128)
  ipAddress        String?  @map("ip_address") @db.Inet
  userAgent        String?  @map("user_agent")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model DeviceSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") @db.VarChar(128)
  platform   String?  @db.VarChar(32)
  appVersion String?  @map("app_version") @db.VarChar(32)
  pushToken  String?  @map("push_token")
  isTrusted  Boolean  @default(true) @map("is_trusted")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(64)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRoleLink[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  description String?
  module      String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleLink {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user           User @relation("user_role_user", fields: [userId], references: [id], onDelete: Cascade)
  role           Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("user_role_assigned_by", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId      String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy   String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user         User       @relation("user_permission_user", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?      @relation("user_permission_granted_by", fields: [grantedBy], references: [id])

  @@id([userId, permissionId])
  @@map("user_permissions")
}

enum VisitStatus {
  planned
  started
  completed
  skipped

  @@map("visit_status")
}

enum OrderStatus {
  draft
  pending_payment
  paid
  processing
  packed
  shipped
  delivered
  cancelled
  returned

  @@map("order_status")
}

enum PaymentStatus {
  unpaid
  paid
  refunded
  partial

  @@map("payment_status")
}

enum DeliveryStatus {
  pending
  label_created
  in_transit
  delivered
  failed
  returned

  @@map("delivery_status")
}

model GpsLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") @db.VarChar(128)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  lat        Float
  lng        Float
  accuracyM  Float?   @map("accuracy_m")
  speedKmh   Float?   @map("speed_kmh")
  isMocked   Boolean  @default(false) @map("is_mocked")

  @@map("gps_logs")
}

model Visit {
  id         String      @id @default(uuid()) @db.Uuid
  managerId  String      @map("manager_id") @db.Uuid
  clientId   String      @map("client_id") @db.Uuid
  plannedAt  DateTime?   @map("planned_at") @db.Timestamptz(6)
  startedAt  DateTime?   @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime?   @map("ended_at") @db.Timestamptz(6)
  status     VisitStatus @default(planned)
  startGpsId String?     @map("start_gps_id") @db.Uuid
  endGpsId   String?     @map("end_gps_id") @db.Uuid
  distanceM  Float?      @map("distance_m")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  events VisitEvent[]

  @@map("visits")
}

model VisitEvent {
  id         String   @id @default(uuid()) @db.Uuid
  visitId    String?  @map("visit_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  geofenceId String?  @map("geofence_id") @db.Uuid
  gpsLogId   String?  @map("gps_log_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(32)
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  visit Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@map("visit_events")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  orderNumber      String        @unique @map("order_number") @db.VarChar(32)
  clientId         String        @map("client_id") @db.Uuid
  source           String        @default("store") @db.VarChar(32)
  status           OrderStatus   @default(draft)
  paymentStatus    PaymentStatus @default(unpaid) @map("payment_status")
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency         String        @default("UAH") @db.VarChar(3)
  createdFromDealId String?      @map("created_from_deal_id") @db.Uuid
  managerId        String?       @map("manager_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  items     OrderItem[]
  delivery  Delivery?  @relation("order_delivery")

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  qty         Int
  priceAmount Decimal  @map("price_amount") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Delivery {
  id                 String         @id @default(uuid()) @db.Uuid
  orderId            String         @unique @map("order_id") @db.Uuid
  provider           String         @default("nova_poshta") @db.VarChar(64)
  status             DeliveryStatus @default(pending)
  addressId          String?        @map("address_id") @db.Uuid
  shippingCost       Decimal        @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  ttn                String?        @db.VarChar(64)
  providerRef        String?        @map("provider_ref") @db.VarChar(128)
  estimatedDeliveryAt DateTime?     @map("estimated_delivery_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  order     Order                 @relation("order_delivery", fields: [orderId], references: [id], onDelete: Cascade)
  shipments NovaPoshtaShipment[]
  events    DeliveryEvent[]

  @@map("deliveries")
}

model DeliveryEvent {
  id         String         @id @default(uuid()) @db.Uuid
  deliveryId String         @map("delivery_id") @db.Uuid
  status     DeliveryStatus
  rawStatus  String?        @map("raw_status") @db.VarChar(128)
  payload    Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_events")
}

model NovaPoshtaShipment {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  npRef      String?  @map("np_ref") @db.VarChar(128)
  ttn        String?  @db.VarChar(64)
  status     String?  @db.VarChar(64)
  costAmount Decimal? @map("cost_amount") @db.Decimal(12, 2)
  raw        Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("nova_poshta_shipments")
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(64)
  eventType   String   @map("event_type") @db.VarChar(64)
  payload     Json     @default("{}")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  status      String   @default("new") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("webhook_events")
}
