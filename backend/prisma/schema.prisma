generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  client
  logistics

  @@map("user_role")
}

enum UserStatus {
  active
  blocked
  pending

  @@map("user_status")
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String?         @unique @db.Citext
  phone           String?         @unique @db.VarChar(32)
  passwordHash    String          @map("password_hash")
  role            UserRole
  status          UserStatus      @default(active)
  isEmailVerified Boolean         @default(false) @map("is_email_verified")
  isPhoneVerified Boolean         @default(false) @map("is_phone_verified")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)

  profile         UserProfile?
  managerProfile  ManagerProfile?
  clientProfile   ClientProfile?
  sessions        UserSession[]
  devices         DeviceSession[]
  userRoles       UserRoleLink[]  @relation("user_role_user")
  assignedRoles   UserRoleLink[]  @relation("user_role_assigned_by")
  userPermissions UserPermission[] @relation("user_permission_user")
  grantedPerms    UserPermission[] @relation("user_permission_granted_by")

  @@map("users")
}

model UserProfile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  firstName String? @map("first_name") @db.VarChar(80)
  lastName  String? @map("last_name") @db.VarChar(80)
  avatarUrl String? @map("avatar_url")
  locale    String? @db.VarChar(16)
  timezone  String? @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ManagerProfile {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  employeeCode String? @map("employee_code") @db.VarChar(64)
  department   String? @db.VarChar(80)
  position     String? @db.VarChar(80)
  hiredAt      DateTime? @map("hired_at") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_profiles")
}

model ClientProfile {
  id                     String  @id @default(uuid()) @db.Uuid
  userId                 String  @unique @map("user_id") @db.Uuid
  companyName            String? @map("company_name") @db.VarChar(255)
  taxId                  String? @map("tax_id") @db.VarChar(64)
  notes                  String?
  preferredContactChannel String? @map("preferred_contact_channel") @db.VarChar(32)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  deviceId         String?  @map("device_id") @db.VarChar(128)
  ipAddress        String?  @map("ip_address") @db.Inet
  userAgent        String?  @map("user_agent")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model DeviceSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") @db.VarChar(128)
  platform   String?  @db.VarChar(32)
  appVersion String?  @map("app_version") @db.VarChar(32)
  pushToken  String?  @map("push_token")
  isTrusted  Boolean  @default(true) @map("is_trusted")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(64)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRoleLink[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  description String?
  module      String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleLink {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user           User @relation("user_role_user", fields: [userId], references: [id], onDelete: Cascade)
  role           Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("user_role_assigned_by", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId      String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedBy   String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  user         User       @relation("user_permission_user", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?      @relation("user_permission_granted_by", fields: [grantedBy], references: [id])

  @@id([userId, permissionId])
  @@map("user_permissions")
}

enum VisitStatus {
  planned
  started
  completed
  skipped

  @@map("visit_status")
}

model GpsLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") @db.VarChar(128)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  lat        Float
  lng        Float
  accuracyM  Float?   @map("accuracy_m")
  speedKmh   Float?   @map("speed_kmh")
  isMocked   Boolean  @default(false) @map("is_mocked")

  @@map("gps_logs")
}

model Visit {
  id         String      @id @default(uuid()) @db.Uuid
  managerId  String      @map("manager_id") @db.Uuid
  clientId   String      @map("client_id") @db.Uuid
  plannedAt  DateTime?   @map("planned_at") @db.Timestamptz(6)
  startedAt  DateTime?   @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime?   @map("ended_at") @db.Timestamptz(6)
  status     VisitStatus @default(planned)
  startGpsId String?     @map("start_gps_id") @db.Uuid
  endGpsId   String?     @map("end_gps_id") @db.Uuid
  distanceM  Float?      @map("distance_m")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  events VisitEvent[]

  @@map("visits")
}

model VisitEvent {
  id         String   @id @default(uuid()) @db.Uuid
  visitId    String?  @map("visit_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  geofenceId String?  @map("geofence_id") @db.Uuid
  gpsLogId   String?  @map("gps_log_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(32)
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  visit Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@map("visit_events")
}
